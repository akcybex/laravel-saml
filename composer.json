{
    "name": "akcybex/laravel-saml",
    "description": "SAML 2.0 service-provider login for Laravel: SP metadata, SP-initiated sign-in, strict response validation.",
    "keywords": ["laravel", "saml", "saml2", "sso", "single-sign-on", "service-provider"],
    "license": "MIT",
    "authors": [
        { "name": "AKCybex", "email": "developers@akcybex.com" }
    ],
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-openssl": "*",
        "illuminate/support": "^12.0 || ^13.0",
        "robrichards/xmlseclibs": "^3.1.4"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Akcybex\\LaravelSaml\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Akcybex\\LaravelSaml\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Akcybex\\LaravelSaml\\SamlServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
